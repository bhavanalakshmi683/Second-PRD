
class Main {

    public static void main(String[] args) {
        int day = 1;

        System.out.println("ATTENDANCE REPORT");
        System.out.println();
        int present = 0;
        int absent = 0;

        while (day <= 10) {

            int today = 0;

            if (day == 1) {
                today = 1;
            } else if (day == 2) {
                today = 1;
            } else if (day == 3) {
                today = 1;
            } else if (day == 4) {
                today = 1;
            } else if (day == 5) {
                today = 1;
            } else if (day == 6) {
                today = 1;
            } else if (day == 7) {
                today = 0;
            } else if (day == 8) {
                today = 1;
            } else if (day == 9) {
                today = 1;
            } else {
                today = 1;
            }

            if (today == 1) {
                present++;
            } else if (today == 0) {
                absent++;
            } else {
                System.out.println("Invalid found ");

            }
            day++;
        }
        int totaldays = present + absent;
        int totalPresent = present;
        int totalAbsent = absent;

        double attendancePercentage = (double) totalPresent / totaldays * 100;

        String attendanceStatus = (attendancePercentage >= 75)
                ? "Eligible"
                : "Not Eligible";

        String message;

        if (attendancePercentage >= 75) {
            message = "Good Attendance";
        } else if (attendancePercentage >= 50) {
            message = "Moderate Attendance";
        } else {
            message = "Poor Attendance";
        }

        System.out.println(
                "Total Working Days: " + totaldays);
        System.out.println(
                "Present Days: " + totalPresent);
        System.out.println(
                "Absent Days: " + totalAbsent);
        System.out.printf(
                "Attendance Percentage: %.2f%%\n", attendancePercentage);
        System.out.println();

        System.out.println("Required Attendance: 75.0%");

        System.out.println(
                "Eligibility Status: " + attendanceStatus);
        System.out.println(
                "Consistency Status: " + message);

        System.out.println();
    }
}


class Main {

    public static void main(String[] args) {
        int scenario
                = 1;
        double monthlyIncome = 0;
        double homeContribution = 0;
        double Rent = 0;
        double foodExpenses = 0;
        double travelExpenses = 0;
        double educationExpenses = 0;
        double totalExpenses = 0;
        double otherExpenses = 0;

        double remainingAmount = 0;
        double savingsPercentage = 0;
        double expensePercentage = 0;

        System.out.println("MONTHLY FINANCIAL REPORT");
        System.out.println();

        do {

            if (scenario == 1) {
                monthlyIncome = 70000.0;
                homeContribution = 10000.0;
                Rent = 6000.0;
                foodExpenses = 5000.0;
                travelExpenses = 3000.0;
                educationExpenses = 25000.0;
                otherExpenses = 1000.0;
            } else {
                monthlyIncome = 50000.0;
                homeContribution = 10000;
                Rent = 6000.0;
                foodExpenses = 5000.0;
                travelExpenses = 3000.0;
                educationExpenses = 20000.0;
                otherExpenses = 1000;
            }
            totalExpenses = homeContribution + Rent + foodExpenses + travelExpenses + educationExpenses + otherExpenses;
            remainingAmount = monthlyIncome - totalExpenses;

            savingsPercentage = (remainingAmount / monthlyIncome) * 100;
            expensePercentage = (totalExpenses / monthlyIncome) * 100;
            boolean expensesExceedIncome = totalExpenses > monthlyIncome;
            String financialCategory;

            if (savingsPercentage < 10) {
                financialCategory = "Critical";
            } else if (savingsPercentage < 20) {
                financialCategory = "Needs Improvement";
            } else if (savingsPercentage < 30) {
                financialCategory = "Good";
            } else {
                financialCategory = "Excellent";
            }

            String message = expensesExceedIncome
                    ? "Expenses exceed income. Immediate action is required."
                    : (savingsPercentage < 20
                            ? "Reduce expenses and improve savings."
                            : "Savings are healthy but can be improved.");

            System.out.println("Scenario: " + scenario);
            System.out.println("Monthly Income: " + monthlyIncome);
            System.out.println("Total Expenses: " + totalExpenses);
            System.out.println("Savings: " + remainingAmount);
            System.out.println();

            System.out.printf("Expense Percentage: %.2f%%%n",
                    expensePercentage);

            System.out.printf("Savings Percentage: %.2f%%%n",
                    savingsPercentage);

            System.out.println();

            System.out.println("Financial Category: " + financialCategory);

            System.out.println("Message: " + message);

            System.out.println();

            scenario++;
        } while (scenario <= 2);

    }

}
